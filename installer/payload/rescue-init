#!/bin/sh
# NPU 急救 initramfs 的 /init。
#
# 目标：只靠"U-Boot + 串口推十几 MB"，把 NPU 变成一个能从外面拉整份 rootfs 的靶子。
# 所以这里只做三件事：
#   1. 把网络拉起来 —— **两条都试**：
#      a) 面板网口：装上 mvpp2 + DSA(mv88e6xxx)，p1 会和 vNTB 的 eth0 桥在一起，
#         这样 PC 插在面板口上就能直接喂镜像，不需要 x86 参与。
#      b) vNTB：PCIe 端点起来之后 eth0 就有了，x86 那边又能说话。
#      两条进门以后在同一个 br0 里，谁通都能用。
#   2. 给 br0 配一个地址（默认 10.234.56.11/24，刻意避开 x86 的 .2）。
#   3. 从 rescue.url 把 p2 的整盘影像 wget 下来 dd 进去，可选 sha256 校验，重启。
#
# 不用 NBD、不用 ssh、不用 zstd —— busybox 的 wget/dd/sha256sum 就够了，
# initramfs 因此能压到十几 MB。所有参数都可以用内核 cmdline 覆盖：
#   rescue.url=… rescue.url2=… rescue.part=… rescue.ip=… rescue.sha256=…
set -u

/bin/busybox --install -s /bin 2>/dev/null
export PATH=/bin:/sbin

echo "rescue: booting $(uname -r)"

mount -t proc     none /proc  2>/dev/null
mount -t sysfs    none /sys   2>/dev/null
mount -t devtmpfs none /dev   2>/dev/null
mkdir -p /sys/kernel/config /run
mount -t configfs none /sys/kernel/config 2>/dev/null

URL=$(sed -n 's/.*rescue\.url=\([^ ]*\).*/\1/p' /proc/cmdline)
URL2=$(sed -n 's/.*rescue\.url2=\([^ ]*\).*/\1/p' /proc/cmdline)
PART=$(sed -n 's/.*rescue\.part=\([^ ]*\).*/\1/p' /proc/cmdline)
IP=$(sed -n 's/.*rescue\.ip=\([^ ]*\).*/\1/p' /proc/cmdline)
SHA=$(sed -n 's/.*rescue\.sha256=\([^ ]*\).*/\1/p' /proc/cmdline)
DEV=$(sed -n 's/.*rescue\.dev=\([^ ]*\).*/\1/p' /proc/cmdline)
MODE=$(sed -n 's/.*rescue\.mode=\([^ ]*\).*/\1/p' /proc/cmdline)
AUTO=$(sed -n 's/.*rescue\.auto=\([^ ]*\).*/\1/p' /proc/cmdline)
URL=${URL:-http://10.234.56.10:8080/p2.img}
PART=${PART:-/dev/mmcblk0p2}
IP=${IP:-10.234.56.11/24}
DEV=${DEV:-p1}
MODE=${MODE:-write}
ONESHOT=$(sed -n 's/.*rescue\.oneshot=\([^ ]*\).*/\1/p' /proc/cmdline)
LOGDEV=$(sed -n 's/.*rescue\.log=\([^ ]*\).*/\1/p' /proc/cmdline)
LOGF=/tmp/rescue.log

# rescue.log=<dev>:<4K-block> —— 这台机器没有自己的控制台（UART 只接在 x86 的
# ttyS2 上），所以"出问题时看一眼日志"必须换个通道：整份日志写到 eMMC 的空闲
# 块里，重启后从正常系统 dd 出来。
if [ -n "$LOGDEV" ]; then
	exec >>"$LOGF" 2>&1
	echo "rescue: log 写到 $LOGDEV"
fi

flush_log() {
	[ -n "$LOGDEV" ] || return 0
	sync
	dd if="$LOGF" of="${LOGDEV%%:*}" bs=4096 seek="${LOGDEV##*:}" conv=notrunc 2>/dev/null
	sync
}

# 重启必须绕开 device_shutdown()。
# 2026-11-25 真机实测：面板口 link 拉起来之后，`reboot -f` 会卡在 mvpp2/DSA 的
# shutdown 里 —— 机器停在急救系统不回来，而 ICMP 还通，看起来像"什么都没发生"。
# sysrq-b 走 emergency_restart()，不碰任何驱动。
hard_reboot() {
	flush_log
	if [ -w /proc/sysrq-trigger ]; then
		echo "rescue: sysrq-b 硬重启"
		echo b >/proc/sysrq-trigger
	fi
	echo "rescue: 退回 reboot -f"
	sync
	sleep 1
	reboot -f
}

# rescue.oneshot=<dev>:<4K-block> —— "只启动一次"入口的自毁开关，也是急救系统
# 到底有没有跑起来的铁证（没有控制台的机器上就靠它）。放在最前面：只要 /init
# 被执行到，这个扇区就会被清零，之后的 U-Boot booti 一定失败、回落到正常系统。
if [ -n "$ONESHOT" ]; then
	echo "rescue: oneshot 清除 ${ONESHOT%%:*} 块 ${ONESHOT##*:}"
	dd if=/dev/zero of="${ONESHOT%%:*}" bs=4096 seek="${ONESHOT##*:}" count=1 conv=notrunc 2>/dev/null
	sync
fi

# 内核自己带驱动时（build-rescue-kernel.sh 产的那个），initramfs 里没有
# /lib/modules，也没必要 modprobe —— 这里静默跳过，不然日志里全是假失败。
have_mods() { [ -d /lib/modules ] && [ -n "$(ls -A /lib/modules 2>/dev/null)" ]; }

modprobe_() {
	have_mods || return 0
	command -v modprobe >/dev/null 2>&1 || return 0
	if ! modprobe "$1" 2>/tmp/moderr; then
		echo "rescue: modprobe $1 失败: $(cat /tmp/moderr 2>/dev/null)"
	fi
}

# ---- 0. eMMC：没有它 /dev/mmcblk0p2 根本不存在 ----
# 这颗 SoC（AP807）的 eMMC 归 Marvell 的 **Xenon** 驱动管：模块叫
# sdhci-xenon-driver，注册出来的驱动名是 xenon-sdhci。Debian 内核里的
# sdhci-of-dwcmshc 只认 snps,dwcmshc-sdhci —— 对着 marvell,armada-ap807-sdhci
# 加载会"成功"但永远不 bind（dmesg 只留一句 "Error: No device match data found"），
# 2026-11-25 在这上面绕了很久。
echo "rescue: 载入 eMMC 驱动（Xenon）"
for m in sdhci sdhci-pltfm cqhci sdhci-xenon-driver; do
	modprobe_ "$m"
done
if [ ! -e /dev/mmcblk0 ] && [ -d /sys/bus/platform/drivers/xenon-sdhci ]; then
	echo f06e0000.mmc >/sys/bus/platform/drivers/xenon-sdhci/bind 2>/dev/null &&
		echo "rescue: 手动 bind 了 f06e0000.mmc"
fi
sleep 1
echo "rescue: 块设备: $(ls /dev/mmcblk* 2>/dev/null | tr '\n' ' ')"

# ---- 1a. 面板网口：mvpp2（CPU 口 eth0）+ DSA 交换机（p1..p8）----
# 顺序是实测出来的，不能乱：
#   * MDIO 那几层（mdio/acpi_mdio/fwnode_mdio/of_mdio/phylink）必须在 mvmdio
#     之前，否则 mvmdio 直接因为 __acpi_mdiobus_register 缺符号加载失败，
#     交换机就不会出现；
#   * bridge 要 llc + stp；
#   * dsa_core 要 selftests + hsr。
echo "rescue: 载入面板网口驱动"
for m in libphy mdio acpi_mdio fwnode_mdio of_mdio mdio_devres fixed_phy \
	phylink sfp phy-mvebu-cp110-comphy mvpp2 \
	llc stp bridge selftests hsr dsa_core tag_dsa mv88e6xxx; do
	modprobe_ "$m"
done

# ---- 1b. vNTB 端点（和 /usr/local/sbin/xgs-vntb.sh 同样的顺序）----
# 精简内核里没有 PCIe endpoint（那些 ntb_* 是 Marvell 厂商树的东西，编不进
# vanilla 内核），configfs 的 pci_ep 目录就不存在 —— 直接跳过，别干等 20 秒。
if [ -d /sys/kernel/config/pci_ep ] || have_mods; then
echo "rescue: 拉起 vNTB 端点"
modprobe_ configfs
for m in pci_ep_cfs pcie_dw_plat ntb_core pci_epf_vntb; do
	modprobe_ "$m"
done
fi

EPC=f2600000.pcie
i=0
while [ -d /sys/class/pci_epc ] && [ ! -d "/sys/class/pci_epc/$EPC" ] && [ "$i" -lt 20 ]; do
	i=$((i + 1)); sleep 1
done
[ -d /sys/class/pci_epc ] || echo "rescue: 内核没有 pci_epc（精简内核正常），vNTB 这条路没有"
if [ -d "/sys/class/pci_epc/$EPC" ]; then
	C=/sys/kernel/config/pci_ep
	F=$C/functions/pci_epf_vntb/func1
	N=$F/pci_epf_vntb.0
	mkdir -p "$C/functions/pci_epf_vntb" 2>/dev/null || true
	[ -d "$F" ] || mkdir "$F" 2>/dev/null
	echo 0x1957 >"$F/vendorid" 2>/dev/null
	echo 0x0809 >"$F/deviceid" 2>/dev/null
	echo 16 >"$F/msi_interrupts" 2>/dev/null
	echo 4 >"$N/db_count" 2>/dev/null
	echo 128 >"$N/spad_count" 2>/dev/null
	echo 1 >"$N/num_mws" 2>/dev/null
	echo 0x100000 >"$N/mw1" 2>/dev/null
	echo 0x1957 >"$N/vntb_vid" 2>/dev/null
	echo 0x080A >"$N/vntb_pid" 2>/dev/null
	echo 0x10 >"$N/vbus_number" 2>/dev/null
	ln -sf "$F" "$C/controllers/$EPC/func1" 2>/dev/null
	echo 1 >"$C/controllers/$EPC/start" 2>/dev/null
fi
# ntb_hw_epf is the *host* side driver and does not belong on the NPU.
for m in ntb_core ntb_transport ntb_netdev; do
	modprobe_ "$m"
done

# ---- 2. 网络：给面板口配地址 ----
# 2026-11-25 实测：DSA 的用户口 p1 是独立网口，PC 插上去直接配地址就能通，
# **不需要桥**（bridge.ko 只是 dsa_core/mv88e6xxx 的加载依赖）。所以这里不建
# br0：少一层，少一个坏点。CPU 口 eth0（mvpp2）必须 up，否则 p1 收了包也上不来。
# DEV 默认 p1（面板口 1）；p2 是 WAN 口，那条线通常直接通到家里的交换机，
# 所以"从 U 盘救 NPU、镜像放在局域网某台机器上"这条路用 DEV=p2。
i=0
while [ ! -e /sys/class/net/eth0 ] && [ "$i" -lt 25 ]; do
	i=$((i + 1)); sleep 1
done
i=0
while [ ! -e "/sys/class/net/$DEV" ] && [ "$i" -lt 25 ]; do
	i=$((i + 1)); sleep 1
done
echo "rescue: 网络设备: $(ls /sys/class/net | tr '\n' ' ')"
if [ ! -e "/sys/class/net/$DEV" ]; then
	echo "rescue: 面板口 $DEV 没出来，dmesg 尾巴："
	dmesg | tail -15
fi
ip link set eth0 up 2>/dev/null
if [ -e "/sys/class/net/$DEV" ]; then
	ip link set eth0 up 2>/dev/null
	# 急救 shell 里的 busybox ip 有时不认 "ip addr add"，ifconfig 一定行。
	ip addr add "$IP" dev "$DEV" 2>/dev/null ||
		ifconfig "$DEV" "${IP}" up 2>/dev/null ||
		ifconfig "$DEV" "${IP%%/*}" netmask 255.255.255.0 up 2>/dev/null
	# 光配地址不算数：接口可能还是 DOWN —— 那样 /sys/class/net/$DEV/carrier
	# 读不出来，ICMP 直接 "Network is unreachable"（2026-11-25 实测踩过：
	# `ip addr add` 成功返回，于是下面那个 ifconfig ... up 的兜底永远不执行）。
	ip link set "$DEV" up 2>/dev/null || ifconfig "$DEV" up 2>/dev/null
	i=0
	while [ "$(cat "/sys/class/net/$DEV/carrier" 2>/dev/null)" != 1 ] && [ "$i" -lt 15 ]; do
		i=$((i + 1))
		sleep 1
	done
	echo "rescue: $DEV link=$(cat "/sys/class/net/$DEV/carrier" 2>/dev/null) state=$(cat "/sys/class/net/$DEV/operstate" 2>/dev/null)"
	ifconfig "$DEV" 2>/dev/null | head -3
fi
ip -br a 2>/dev/null

# ---- 2b. probe：只验证"面板口通不通 / HTTP 能不能拉"，一个字节都不写盘 ----
if [ "$MODE" = probe ]; then
	PING=$(sed -n 's/.*rescue\.ping=\([^ ]*\).*/\1/p' /proc/cmdline)
	echo "rescue: probe 模式，从 $URL 取数据到 /dev/null"
	for d in $(ls /sys/class/net); do
		[ "$d" = lo ] && continue
		printf '  %-6s link=%s state=%s\n' "$d" \
			"$(cat "/sys/class/net/$d/carrier" 2>/dev/null)" \
			"$(cat "/sys/class/net/$d/operstate" 2>/dev/null)"
	done
	if [ -n "$PING" ]; then
		echo "rescue: ping $PING"
		ping -c 2 -W 2 "$PING" 2>&1 | tail -3
	fi
	n=$(wget -q -T 10 -O - "$URL" 2>/dev/null | wc -c)
	echo "rescue: probe 收到 $n 字节"
	echo "rescue: dmesg 尾巴"
	dmesg | grep -iE 'comphy|mvpp2|mv88e|dsa|link is|error|fail' | tail -25
	flush_log
	[ "$AUTO" = reboot ] && { echo "rescue: probe 结束，重启"; hard_reboot; }
	exec sh
fi
# ---- 3. 拉影像 + 写盘 ----
[ -b "$PART" ] || { echo "rescue: $PART 不存在"; exec sh; }

fetch() {
	url=$1
	echo "rescue: 试 $url"
	RC=/tmp/wget.rc
	rm -f "$RC"
	# 别信管道的退出码：dd 在下载被截断时也可能返回 0。
	# -T：busybox wget 默认超时 900 秒，对端接了连接却不发数据时会干等 15 分钟
	# （2026-11-25 实测：probe 卡在 wget 上，整台机器停在急救系统里不重启）。
	( wget -T 20 -q -O - "$url"; echo $? >"$RC" ) | dd of="$PART" bs=1M 2>/dev/null
	dd_rc=$?
	wget_rc=$(cat "$RC" 2>/dev/null || echo 1)
	rm -f "$RC"
	echo "rescue: wget rc=$wget_rc dd rc=$dd_rc"
	[ "$wget_rc" = 0 ] && [ "$dd_rc" = 0 ]
}

wrote=0
if fetch "$URL"; then
	wrote=1
elif [ -n "$URL2" ] && fetch "$URL2"; then
	wrote=1
fi

if [ "$wrote" = 1 ]; then
	sync
	if [ -n "$SHA" ]; then
		got=$(dd if="$PART" bs=1M 2>/dev/null | sha256sum | cut -d' ' -f1)
		echo "rescue: p2 sha256 $got / 期望 $SHA"
		if [ "$got" != "$SHA" ]; then
			echo "rescue: 校验不过，不重启，给你一个 shell"
			[ "$AUTO" = reboot ] || exec sh
		fi
	fi
	echo "rescue: 写完了，重启"
	hard_reboot
fi

echo "rescue: 下载/写入失败 —— 检查 $DEV 的地址和 HTTP 服务；给你一个 shell"
flush_log
# rescue.auto=reboot：无人值守时别停在 shell 里，直接回正常系统
[ "$AUTO" = reboot ] && { echo "rescue: auto=reboot，重启"; hard_reboot; }
exec sh
