# Packages both machines need.  Everything here is required by a unit or a
# script in systemd/, or by the boot path -- nothing is "nice to have".
systemd,systemd-sysv,udev,dbus,kmod
apt,ca-certificates
iproute2,iputils-ping,ethtool
openssh-server
psmisc,procps,util-linux,util-linux-extra
less,vim-tiny
zstd,xz-utils
systemd-timesyncd,fake-hwclock
systemd-resolved
tzdata,locales,console-setup
# the NPU still carries a legacy /etc/network/interfaces for lo
ifupdown
