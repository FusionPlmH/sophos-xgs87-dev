# Packages both machines need.  Everything here is required by a unit or a
# script in systemd/, or by the boot path -- nothing is "nice to have".
systemd,systemd-sysv,udev,dbus,kmod
apt,ca-certificates
iproute2,iputils-ping,ethtool
openssh-server
sudo
psmisc,procps,util-linux,util-linux-extra
less,vim-tiny
zstd,xz-utils
systemd-timesyncd,fake-hwclock
# growpart, for the first-boot root partition growth
cloud-guest-utils
# tzdata for the clock, but no locales/console-setup: the box is driven over a
# serial console, and C.UTF-8 is built into glibc (image/setup.sh sets it).
systemd-resolved
tzdata
# usbip: NPU 上一个 USB 主控都没有，靠 vhci-hcd（虚拟主控）+ 这条工具把 x86 的
# USB 设备借过来。usb.ids 只是为了让 `usbip list` 打印厂商名。实测可用，
# 见 docs/07 §7.14。
usbip,usb.ids
