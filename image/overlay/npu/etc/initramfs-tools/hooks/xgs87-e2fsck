#!/bin/sh
# Make sure the initramfs can repair the root filesystem.
#
# initramfs-tools only copies e2fsck when its stock "fsck" hook can identify
# the root filesystem, which it cannot do while the image is built in a chroot
# (there is no /dev/mmcblk0p2 to probe).  The result was an initramfs with no
# e2fsck at all, so `fsck.mode=force fsck.repair=yes` silently did nothing and
# a damaged p2 could only be repaired offline.
#
# Usage after that: put `fsck.mode=force fsck.repair=yes` on the kernel command
# line (or touch /forcefsck) once, boot, then remove it again.

PREREQ=""

prereqs() {
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /sbin/e2fsck /sbin
copy_exec /sbin/fsck.ext4 /sbin 2>/dev/null || true
