#
# x86 side.
#
# netcat-openbsd is REQUIRED: xgs-netconsole.service runs /usr/bin/nc -u -l -k
# to receive the NPU's kernel console.  Missing it does not break the boot, it
# just leaves you blind exactly when you need the log.
#
# This machine has no network hardware of its own -- the only netdev is the
# vNTB link -- so everything that touches it is on the critical path.
linux-image-amd64
grub-efi-amd64,grub-efi-amd64-signed,shim-signed,efibootmgr
netcat-openbsd
pciutils,usbutils,dmidecode
iperf3,tcpdump
# the maintenance USB built by installer/mkusb.sh runs on this side
whiptail,python3-minimal
# cpio: npu-rescue.sh inspects the rescue initramfs to decide whether the NPU's
# existing /boot/Image can be reused (saves pushing 13.7 MB over the serial).
cpio
# picocom: the NPU console lives on this machine's /dev/ttyS2 (115200 8N1;
# the old hand-installed image kernel needed host 57600).
# Without it the fallback relay drops Ctrl-C handling and echo.
picocom
# the USB stick's backup partition is exfat, and it gets cut on first boot
exfatprogs,gdisk
# NBD 先禁用：nbd-client 不装了（NPU 那边也没有 nbd-server），
# 装它的唯一用途是把 NPU 的 eMMC 挂成 /dev/nbd0 —— 等这一级实测通过再加回来。