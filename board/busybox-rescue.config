# 急救 initramfs 里那个静态 busybox 的配置片段（busybox 1.38.0）。
#
# 用法：见 tools/build/build-rescue-busybox.sh。它是**片段**，不是完整 .config：
# 脚本先 `make allnoconfig`，再把这里的行**就地替换**进 .config。
#
#   ⚠ 不能像内核那样 `cat 片段 >> .config`。busybox 的 kconfig 对同一个符号
#   第二次出现只打一句 "warning: trying to reassign symbol BUSYBOX" 然后**忽略**，
#   于是整个片段静默失效、编出来的仍是空配置。2026-11-26 在这里绕了两轮。
#   另外 busybox 没有 `olddefconfig` 目标，只有 `oldconfig`，而且要一个 tty
#   （不是 tty 就报 "Console input/output is redirected"）。
#
# 实测（2026-11-26）：
#   Debian busybox-static 1.38.0-3+b2（~390 applet）1 980 720 B，gzip -9 1 030 792 B
#   这个片段（52 applet）                          1 187 880 B，gzip -9   599 079 B
#   → initramfs 少 0.43 MB。
#
# 体积几乎全在静态 glibc（一个 hello world 就要 700 KB+）。想再砍 0.5 MB 只能换
# musl 交叉工具链（aarch64-linux-musl-gcc），属于另一件事，没做。
#
# applet 清单的唯一来源是 installer/payload/rescue-init —— 加 applet 前先看它用
# 什么命令；**减 applet 前必须在真机上跑过一遍**，急救系统缺一个 applet 就是在最
# 要命的时候坏掉。

# --- 多调用二进制本身 ---
# BUSYBOX=y + FEATURE_INSTALLER=y 才有 `busybox --install -s /bin`，
# 而 rescue-init 第一行就是它：没有它 /bin 里除了 sh 什么都没有。
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_INSTALL_APPLET_HARDLINKS=n
CONFIG_INSTALL_APPLET_DONT=n
CONFIG_STATIC=y
CONFIG_SHOW_USAGE=y
CONFIG_LONG_OPTS=n
CONFIG_FEATURE_VERBOSE_USAGE=n

# --- shell：rescue-init 是一个 ash 脚本 ---
# FEATURE_SH_MATH 缺了 `$((i+1))` 直接是语法错误（循环全废），
# 而它默认是关的 —— 第一版就编出了一个不会数数的 shell。
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_EXTRA_QUIET=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=512
CONFIG_FEATURE_EDITING_HISTORY=32
CONFIG_FEATURE_TAB_COMPLETION=y

# --- rescue-init 用到的（顺序按用途）---
CONFIG_UNAME=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_MKDIR=y
CONFIG_SED=y
CONFIG_DD=y
CONFIG_SYNC=y
CONFIG_LS=y
CONFIG_CAT=y
CONFIG_TR=y
CONFIG_WC=y
CONFIG_CUT=y
CONFIG_RM=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_REBOOT=y
CONFIG_POWEROFF=y
CONFIG_HALT=y
CONFIG_PRINTF=y
CONFIG_ECHO=y
CONFIG_TEST=y
CONFIG_GREP=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_IFCONFIG=y
CONFIG_FEATURE_IFCONFIG_STATUS=y
CONFIG_DMESG=y
CONFIG_PING=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_TIMEOUT=y

# --- 急救 shell 里手动排查用的（都很小，留着省事）---
CONFIG_PS=y
CONFIG_FREE=y
CONFIG_DF=y
CONFIG_HEXDUMP=y
CONFIG_EXPR=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_FIND=y
CONFIG_CHMOD=y
CONFIG_LN=y
CONFIG_MV=y
CONFIG_CP=y
CONFIG_TOUCH=y
CONFIG_MKNOD=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_HOSTNAME=y
CONFIG_ID=y
CONFIG_KILL=y
CONFIG_ENV=y
