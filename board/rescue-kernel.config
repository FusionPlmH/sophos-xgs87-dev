# 急救内核的配置片段（arm64 / CN9130 = AP807 + CP115）。
#
# 用法：先 `make tinyconfig`，再把这个片段 merge 上去，然后 olddefconfig。
#   ./tools/build/build-rescue-kernel.sh --src /path/linux-6.12 --out out/rescue-kernel
#
# 2026-11-25 实测（linux-6.12，aarch64-linux-gnu-gcc 14.2，16 核，约 2 分钟）：
#
#   Image 5.36 MB ｜ gzip -9 2.14 MB ｜ lzma -9 1.63 MB
#   Debian 自带的 Image 37.7 MB（gz 13.7 MB）—— 小 7 倍
#   急救包：内核 2.14 + initramfs 1.04 + dtb 0.02 = 3.1 MB（原来是 15.96 MB）
#           （内核换 lzma 的话 2.6 MB，但 U-Boot 的 unzip 认不认 lzma 还没验过）
#   串口 9.8 KiB/s 推一包：约 6 分钟（原来 27 分钟）
#
# 2026-11-25 真机验证（U-Boot ext4load + booti，不只是 QEMU）：
#   * xenon eMMC 认出全部 4 个分区
#   * mvpp2（10G CPU 口）+ mvmdio + mv88e6xxx（DSA）都起来，p1..p8 + sfp 都在
#   * 面板口 p2 拉起来后能配地址、能回 ICMP
#
# ⚠️ 绝不能「defconfig 打底再关几十项」：arm64 defconfig 自带 2800 多个 =y，
#    那样编出来是 40.6 MB / gz 12.3 MB，比 Debian 的还大。必须 tinyconfig 打底。
#
# ⚠️ tinyconfig = allnoconfig + EXPERT，所以**所有 default y 的东西都被关掉**。
#    已经踩过的四个坑，每一个都表现为"QEMU 里能跑、真机上死"或"死得没声音"：
#
#    1. 全部 CPU errata 被关掉，包括 CONFIG_ARM64_ERRATUM_843419（A53/A72 的
#       ADRP 链接期修正）。QEMU 的 -cpu max 没有这个 erratum，所以 QEMU 永远
#       测不出来；真机上内核在打印任何东西之前就死了。下面把 errata 全打开。
#    2. CONFIG_BLOCK 被关掉（它带 "if EXPERT"），于是 CONFIG_MMC_BLOCK 这个
#       符号根本不存在 —— 一个 /dev/mmcblk0 都不会有。
#    3. fs/pstore/Kconfig 在 "if MISC_FILESYSTEMS" 里面，没有 MISC_FILESYSTEMS
#       时 CONFIG_PSTORE 会被静默丢弃（merge_config 不报错）。
#    4. 交换机内部 PHY 没有 CONFIG_MARVELL_PHY 就退化成 "Generic PHY"，
#       88E6393 的口起不来。
#
# ⚠️ kernel/npu/ 里的 ntb_* 模块编不进这个内核：它们调用 ntb_get_dma_dev()，
#    那是 Marvell 厂商树的 API，vanilla/Debian 6.12 都没有。所以急救内核里
#    PCI/vNTB 一律不要 —— 急救走面板口那条路，本来也不需要 vNTB。
CONFIG_LOCALVERSION="-xgs87rescue"

# --- arch / platform ---
CONFIG_ARCH_MVEBU=y
CONFIG_OF=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# CPU errata：tinyconfig 把整组都关了，见上面坑 1。
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_834220=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1286807=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1418040=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_1542419=y
CONFIG_ARM64_ERRATUM_1742098=y
CONFIG_ARM64_ERRATUM_1902691=y
CONFIG_ARM64_ERRATUM_2038923=y
CONFIG_ARM64_ERRATUM_2051678=y
CONFIG_ARM64_ERRATUM_2054223=y
CONFIG_ARM64_ERRATUM_2064142=y
CONFIG_ARM64_ERRATUM_2067961=y
CONFIG_ARM64_ERRATUM_2077057=y
CONFIG_ARM64_ERRATUM_2119858=y
CONFIG_ARM64_ERRATUM_2139208=y
CONFIG_ARM64_ERRATUM_2224489=y
CONFIG_ARM64_ERRATUM_2253138=y
CONFIG_ARM64_ERRATUM_2441007=y
CONFIG_ARM64_ERRATUM_2441009=y
CONFIG_ARM64_ERRATUM_2457168=y
CONFIG_ARM64_ERRATUM_2645198=y
CONFIG_ARM64_ERRATUM_2658417=y
CONFIG_ARM64_ERRATUM_2966298=y
CONFIG_ARM64_ERRATUM_3117295=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_WORKAROUND_CLEAN_CACHE=y
CONFIG_ARM64_WORKAROUND_REPEAT_TLBI=y
CONFIG_ARM64_WORKAROUND_SPECULATIVE_AT=y
CONFIG_ARM64_WORKAROUND_SPECULATIVE_UNPRIV_LOAD=y
# 32 位 DMA master（mvpp2）需要低地址区，否则描述符地址会超过它的掩码。
CONFIG_ZONE_DMA32=y

# --- console ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_PRINTK=y
CONFIG_BUG=y
# 硬重启：rescue-init 的 hard_reboot() 用 /proc/sysrq-trigger 里的 b
CONFIG_MAGIC_SYSRQ=y

# --- initramfs / rootfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y

# 板子最后 1 MB DRAM 是 ramoops 保留区。留着它，急救内核就算死掉，下一次正常
# 启动还能从 /sys/fs/pstore 读日志 —— 这台机器自己没有可看的控制台。
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- eMMC：AP807 的 eMMC 归 Marvell Xenon 驱动（sdhci-of-dwcmshc 认不了）---
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_XENON=y

# --- 网络 ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_MVMDIO=y
CONFIG_MVPP2=y
CONFIG_MDIO_DEVICE=y
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_FIXED_PHY=y
CONFIG_MARVELL_PHY=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MVEBU_CP110_COMPHY=y

# --- 面板口：mv88e6190 当 DSA 交换机 ---
CONFIG_NET_DSA=y
CONFIG_NET_DSA_MV88E6XXX=y

# --- 明确关掉的（体积大头）---
# tinyconfig 本来就已经关了，写在这里是为了别人不要以为是漏了。
CONFIG_MODULES=n
CONFIG_PCI=n
CONFIG_EXT4_FS=n
CONFIG_BRIDGE=n
CONFIG_HSR=n
CONFIG_NETFILTER=n
CONFIG_IPV6=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MTD=n
CONFIG_USB_SUPPORT=n
CONFIG_WATCHDOG=n
CONFIG_RTC_CLASS=n
CONFIG_THERMAL=n
CONFIG_HWMON=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_SOUND=n
CONFIG_HID=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_SUSPEND=n
CONFIG_SWAP=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PERF_EVENTS=n
CONFIG_PROFILING=n
CONFIG_KALLSYMS=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_EFI=n
