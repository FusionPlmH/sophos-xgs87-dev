# 急救内核的裁剪配置（arm64 / CN9130）。
#
# 目标：只留下"能起 initramfs、能拉起 vNTB、能读 eMMC、能收发 TCP"这些必须的东西。
#
# ⚠️ 2026-11-26 实测（linux-6.12 源码 + aarch64-linux-gnu-gcc 13.3，16 核 6.5 分钟）：
#    用 defconfig 打底再关掉下面这几十项，Image 是 40.6 MB / gz 12.3 MB ——
#    比 Debian 的 37.7 MB / 13.7 MB **没有变小**。原因是 arm64 defconfig 自己就带
#    2800 多个 =y，而这份片段只关了 35 个符号。
#    想真的到几 MB，必须换成 **tinyconfig/allnoconfig 打底、逐个把要用到的符号加回来**
#    （约 200 项），而且每轮都要在真机上验证能不能起 —— 现在的写法不要指望省空间。
#
# ⚠️ 另一个坑：这个内核里 `kernel/npu/` 那批模块编不过 —— 它们调用了
#    `ntb_get_dma_dev()`，那是 Marvell 厂商树的 API，vanilla/Debian 6.12 都没有。
#    现役 NPU 用的是 Debian 自带的 `ntb_transport`，所以急救内核不需要自带 vNTB
#    也能干活（面板口那条路根本不用 vNTB）。
#
# ⚠️ 自己编内核意味着 kernel/npu 里的 ntb_* 模块也要对着**同一个内核**编
# （vermagic 必须一致），所以这个脚本同时产 Image.gz 和模块；不能拿 Debian 的
# 模块配它，也不能拿它配 Debian 的模块。

# --- 必须打开的 ---
CONFIG_ARM64=y
CONFIG_MMU=y
CONFIG_ARCH_MMAP_RND_BITS=18
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
# 串口控制台（当前 Debian 内核 host 115200 = 线上 115200；老 image 内核的
# 16550 base_baud 是标称两倍，那套系统才需要 host 57600）
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_EARLY_PRINTK=y
# PCIe 端点 + DesignWare 控制器（vNTB 全靠它）
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_ENDPOINT=y
CONFIG_PCI_ENDPOINT_CONFIGFS=y
CONFIG_PCI_DW=y
CONFIG_PCI_DW_PLAT=y
CONFIG_PCI_DW_EP=y
CONFIG_PCI_DW_HOST=y
CONFIG_PCI_EPF_TEST=n
# eMMC：这颗 SoC（AP807）归 Marvell 的 Xenon 驱动管，模块/驱动名是
# sdhci-xenon-driver / xenon-sdhci。sdhci-of-dwcmshc 只认 snps,dwcmshc-sdhci，
# 对着 marvell,armada-ap807-sdhci 会"加载成功但永不 bind"（2026-11-25 踩过）。
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_XENON=y
CONFIG_MMC_SDHCI_ACPI=n

# 面板口：mvpp2（10G CPU 口）→ MDIO → mv88e6xxx（DSA）。
# 全部编进内核，急救时就不用管 vermagic 和依赖顺序了。
CONFIG_NET_SWITCHDEV=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_DSA=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVRES=y
CONFIG_MDIO_BITBANG=n
CONFIG_OF_MDIO=y
CONFIG_FWNODE_MDIO=y
CONFIG_ACPI_MDIO=y
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
CONFIG_PHYLINK=y
CONFIG_SFP=y
CONFIG_MVMDIO=y
CONFIG_MVPP2=y
CONFIG_NET_DSA_MV88E6XXX=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_PHY_MVEBU_CP110_COMPHY=y
# 网络：ntb_netdev 是虚拟网卡，底下要 IPv4 + TCP
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_PACKET=y
CONFIG_UNIX=y
# 模块装载（ntb_* 是模块）
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS_NONE=y

# --- 明确不要的（体积大头）---
# 注意：CONFIG_BRIDGE / VLAN 已经在上面打开了 —— dsa_core 和 mv88e6xxx 要它们。
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_USB_SUPPORT=n
CONFIG_EXT4_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_NETFILTER=n
CONFIG_IPV6=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_CRYPTO_USER_API=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KALLSYMS_ALL=n
CONFIG_PROFILING=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PERF_EVENTS=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_CPU_IDLE=n
CONFIG_THERMAL=n
CONFIG_HWMON=n
CONFIG_WATCHDOG=n
CONFIG_SENSORS_ARM_SCPI=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_RTC_CLASS=n
CONFIG_DMA_ENGINE=y