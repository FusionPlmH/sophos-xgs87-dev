[Unit]
Description=Grow the root partition to fill the disk (first boot only)
ConditionPathExists=!/var/lib/xgs87/grown
After=local-fs.target
Before=multi-user.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/xgs87-growroot.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target